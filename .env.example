# Copy to .env (gitignored) and fill in. Anything left blank is prompted for.
# Old (source) Catalyst Center host/IP
DNAC_HOST=
# New (destination) Catalyst Center host/IP
DNAC_NEW_HOST=
# Account used on both systems
DNAC_USER=
DNAC_PASS=
# Optional: exact hierarchy name to migrate without a menu, e.g. Global/Australia/VIC/St Albans
DNAC_SITE=
# Optional: destination path on the new system (blank = same path as the source)
DNAC_DEST=
# Optional: set to true to keep AP placements in the exported maps (default: removed)
# DNAC_KEEP_APS=
# Where --export-only writes archives (default ./map_export_out)
DNAC_OUT=map_export_out
